<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>Demo.Api.Tests</RootNamespace>
    <AssemblyName>Demo.Api.Tests</AssemblyName>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="AwesomeAssertions.Web" Version="2.0.3" />
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Testcontainers" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.15.0" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\Demo.Api\Api.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>


  <ItemGroup>
    <None Include="..\db-init.sql" Link="Data\db-init.sql" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
